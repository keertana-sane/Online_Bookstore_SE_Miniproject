{
  "info": {
    "name": "Online Bookstore - Catalog API",
    "description": "BK-31 automated smoke tests for catalog browsing, pagination, and search.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "TC-CAT-01 - Browse catalog with pagination",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books?page=1&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns JSON', function () { pm.response.to.be.json; });",
              "var data = pm.response.json();",
              "pm.test('Contains books and pagination metadata', function () {",
              "  pm.expect(data).to.have.property('books');",
              "  pm.expect(data).to.have.property('pagination');",
              "  pm.expect(data.books).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-CAT-02 - Search catalog",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books?search=sample&page=1&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns a valid catalog response', function () {",
              "  var data = pm.response.json();",
              "  pm.expect(data.books).to.be.an('array');",
              "  pm.expect(data).to.have.property('pagination');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-CAT-03 - Reject invalid page",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books?page=0&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects invalid page with HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-CAT-04 - Reject invalid limit",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books?page=1&limit=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects invalid limit with HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-CAT-05 - Reject excessively long search",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books?search=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx&page=1&limit=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects search over 100 characters with HTTP 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}